{
  "name": "recall-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recall — a spaced-repetition study coach built on the Cloudflare Agents SDK",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy -c dist/recall_agent/wrangler.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "agents": "^0.24.0",
    "ai": "^7.0.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.136.0"
  }
}
